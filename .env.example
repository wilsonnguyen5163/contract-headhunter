# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Folder holding settings.yaml and the YAML taxonomies (default: ./config).
# JOBMATCH_CONFIG_DIR=config

# Set to 1 after the embedding model is downloaded, so the container never reaches Hugging Face.
HF_HUB_OFFLINE=1

# Gemini API key (v1 matching), from Google AI Studio. Free tier only: no billing on the
# project. Read through settings.yaml llm.api_key_env; never put it in code, logs or docs.
# GEMINI_API_KEY=

# Adzuna API credentials (phase 3, not used yet).
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
